# ─────────────────────────────────────────────────────────────
#  Chai's Aged Accounts OS — API configuration
# ─────────────────────────────────────────────────────────────

# Required. Signs login sessions. Any random 32+ char string.
JWT_SECRET=change-me-to-a-long-random-string

# Required. Encrypts every stored channel password / 2FA seed / recovery email.
# ⚠  If you lose this value, every saved credential becomes unreadable. Back it up.
ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# Optional but strongly recommended — turns on automatic channel syncing.
# Get one free at https://console.cloud.google.com → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=

# ── Exact revenue (optional) ─────────────────────────────────────────────────
# Lets a customer connect their own channel so real AdSense earnings are pulled
# from YouTube Analytics automatically. Without these, revenue stays estimated.
#
# Google Cloud → APIs & Services → Credentials → Create OAuth client ID →
# Web application. Add the redirect URI below to "Authorised redirect URIs".
#
# ⚠  Publish the OAuth consent screen (status must be "In production", not
#    "Testing"). Testing-mode refresh tokens expire after 7 days, which is what
#    forces users of other tools to reconnect every week. See EXACT-REVENUE.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api.onrender.com/api/oauth/youtube/callback

# Where to send the customer back after they approve on Google's screen.
APP_URL=http://localhost:5173

# Postgres connection string. Leave empty locally to use a zero-install SQLite file.
# On Render this is filled in automatically from the linked database.
DATABASE_URL=

# Comma-separated list of allowed frontend origins. Use * only while testing.
CORS_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development
