# ─────────────────────────────────────────────────────────────
#  Chai's Aged Accounts OS — API configuration
# ─────────────────────────────────────────────────────────────

# Required. Signs login sessions. Any random 32+ char string.
JWT_SECRET=change-me-to-a-long-random-string

# Required. Encrypts every stored channel password / 2FA seed / recovery email.
# ⚠  If you lose this value, every saved credential becomes unreadable. Back it up.
ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# Optional but strongly recommended — turns on automatic channel syncing.
# Get one free at https://console.cloud.google.com → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=

# Postgres connection string. Leave empty locally to use a zero-install SQLite file.
# On Render this is filled in automatically from the linked database.
DATABASE_URL=

# Comma-separated list of allowed frontend origins. Use * only while testing.
CORS_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development
